# Copy this file to .env and fill in your real values.
# .env is git-ignored; .env.example is committed as a template.

# Azure AI Foundry OpenAI-compatible endpoint (must include /openai/v1)
# e.g. https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=

# The model/deployment name you created in Azure AI Foundry
AZURE_DEPLOYMENT_NAME=

# Optional: only needed if your account spans multiple tenants.
# When set, the code uses AzureCliCredential with this tenant.
AZURE_TENANT_ID=
